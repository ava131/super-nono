# ── pnpm store 位置（必须显式固定）──────────────────────────────────
# 不固定的话：AI 侧的执行沙箱写不了全局 store（~/Library/pnpm/store），
# pnpm 会退化成项目内的 .pnpm-store；而普通终端默认用全局 store。
# 两边对不上时，pnpm 会认为 node_modules 是"别的环境装的"，
# 于是每次 pnpm start 都要求「removed and reinstalled from scratch」。
# 钉死成项目内相对路径后，任何环境解析出的 storeDir 都一致。
store-dir=.pnpm-store

# ── Electron 二进制下载源 ────────────────────────────────────────────
# 本机直连 github.com 会超时，所以走 npmmirror 镜像。
electron_mirror=https://registry.npmmirror.com/-/binary/electron/

# 如果哪天想改回官方 GitHub Releases，注释掉上面一行、启用下面三行即可
# （本机 7890 代理实测可用）：
# electron_mirror=https://github.com/electron/electron/releases/download/
# proxy=http://127.0.0.1:7890
# https-proxy=http://127.0.0.1:7890
